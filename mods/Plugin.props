<Project>
  <!-- Shared settings for the BepInEx plugins. Game and BepInEx DLLs are referenced in place, never copied. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <HumankindDir Condition="'$(HumankindDir)' == ''">/mnt/d/SteamLibrary/steamapps/common/Humankind</HumankindDir>
    <ManagedDir>$(HumankindDir)/Humankind_Data/Managed</ManagedDir>
    <BepInExCore>$(HumankindDir)/BepInEx/core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)HumankindMods.Core/HumankindMods.Core.csproj" />
    <Reference Include="BepInEx" HintPath="$(BepInExCore)/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)/0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="netstandard" HintPath="$(ManagedDir)/netstandard.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(ManagedDir)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="Amplitude" HintPath="$(ManagedDir)/Amplitude.dll" Private="false" />
    <Reference Include="Amplitude.Framework" HintPath="$(ManagedDir)/Amplitude.Framework.dll" Private="false" />
    <Reference Include="Amplitude.Graphics" HintPath="$(ManagedDir)/Amplitude.Graphics.dll" Private="false" />
    <Reference Include="Amplitude.Mercury" HintPath="$(ManagedDir)/Amplitude.Mercury.dll" Private="false" />
    <Reference Include="Amplitude.Mercury.Data" HintPath="$(ManagedDir)/Amplitude.Mercury.Data.dll" Private="false" />
    <Reference Include="Amplitude.Mercury.Firstpass" HintPath="$(ManagedDir)/Amplitude.Mercury.Firstpass.dll" Private="false" />
    <Reference Include="Amplitude.Mercury.Fx" HintPath="$(ManagedDir)/Amplitude.Mercury.Fx.dll" Private="false" />
  </ItemGroup>
  <!-- dotnet build -p:Deploy=true copies each plugin and Core into the game's plugin folder. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath);$(OutDir)HumankindMods.Core.dll" DestinationFolder="$(HumankindDir)/BepInEx/plugins/ZKidz" />
  </Target>
</Project>
